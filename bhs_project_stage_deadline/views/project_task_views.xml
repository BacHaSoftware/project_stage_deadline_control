<?xml version="1.0"?>
<odoo>
    <data>
        <record id="bhs_show_hide_deadline_task_inherit" model="ir.ui.view">
            <field name="name">bhs.show.hide.deadline.task.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_deadline']" position="attributes">
                    <attribute name="invisible">state in ['1_done','1_canceled'] or not is_show_deadline</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>